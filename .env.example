# OpenAI-compatible embedding endpoint. On this machine that is the multi-model
# llama.cpp provider at :8080; the [embeddinggemma-2] preset in
# C:\Users\maxkr\llama-cpp.ini (embedding = true, parallel = 8,
# ubatch-size/batch-size = 8192, image-max-tokens = 140,
# media-path = C:\Dev\video-analysis-embeddings\.cache\media) serves it.
# Ingest auto-detects the preset's parallel slot count from /v1/models -
# there is no concurrency setting here.
EMBED_BASE_URL=http://127.0.0.1:8080/v1
EMBED_API_KEY=none
EMBED_MODEL=embeddinggemma-2
EMBED_DIMS=768

# Prompt prefix required by EmbeddingGemma 2 for queries.
QUERY_PREFIX=task: search result | query: 

# Chroma (docker compose up -d)
CHROMA_URL=http://127.0.0.1:8806
COLLECTION=video_clips

# Windowing: 30 s keeps a clip inside the 8192-token budget
# (30 frames * 140 tok + 30 s * 25 tok = 4950 tok).
CLIP_SECONDS=30
OVERLAP_SECONDS=5
VIDEO_FPS=1
AUDIO_RATE=16000

# file = send file:// URLs (llama-server must be started with
# --media-path pointing at MEDIA_DIR); base64 = inline the bytes.
MEDIA_TRANSPORT=file
MEDIA_DIR=.cache/media
MANIFEST_PATH=.cache/manifest.json

BATCH_RECORDS=96
